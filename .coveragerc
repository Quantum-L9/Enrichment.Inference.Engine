[run]
source = app
omit =
    app/score/*
    app/health/*
    app/services/simulation_bridge.py
    */tests/*
    */migrations/*

[report]
# C-15 (AGENTS.md): coverage >= 71%, never lowered. The floor lives here, in
# coverage.py's own config, so that ANY run producing a coverage report enforces
# it — a workflow cannot drop the gate by forgetting --cov-fail-under on the
# command line (sonarcloud.yml did exactly that and was covered only by
# pytest.ini's addopts). A subset run passes no --cov at all, produces no report,
# and is therefore unaffected: that is what keeps the subset make targets
# runnable without weakening this threshold. --cov-fail-under on the CLI still
# overrides this value, and the full-suite workflows pass 71 explicitly anyway.
fail_under = 71
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = htmlcov
