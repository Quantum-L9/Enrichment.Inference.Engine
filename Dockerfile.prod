# Production image. The previous version installed poetry and copied a
# `poetry.lock` that does not exist in this repository (the project is
# PEP 621 / setuptools, see pyproject.toml), and had no `git` for the
# git+https constellation-node-sdk dependency, so the build could not succeed.
#
# Supply chain: the base image is python:3.12-slim pinned by digest (the same
# digest Cognitive.Engine.Graphs pins). The previous pin was an untagged
# `python@sha256:8edbf9e…` that a Dependabot docker bump (#204) had moved to
# Python 3.14.7 while this comment still said 3.12; the tag now names the
# version, and uv refuses any interpreter outside requires-python. uv.lock is the single lock: in the `deps` stage
# tools/deps/install_locked.sh bootstraps a hash-pinned uv and syncs the
# runtime profile into /opt/venv, verifying every distribution against the
# sha256 uv.lock records and the Gate SDK at the commit it records. Only
# /opt/venv reaches the final stage: uv and git stay behind.
# The app runs from /app on PYTHONPATH; nothing is pip-installed from the tree.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
# git: uv fetches the Gate SDK from its git source.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /deps
COPY pyproject.toml uv.lock ./
COPY tools/deps/install_locked.sh tools/deps/uv-bootstrap.txt tools/deps/
RUN UV_PROJECT_ENVIRONMENT=/opt/venv bash tools/deps/install_locked.sh runtime

FROM base AS prod
# The venv's interpreter links to /usr/local/bin/python3.12, which this stage
# shares (same base digest).
COPY --from=deps /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY . .
RUN adduser --disabled-password --gecos "" appuser \
    && chown -R appuser /app
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1
# EIE-003: ONE worker per container — see the note in ./Dockerfile. The
# GraphReturnChannel singleton is per-process, so a second worker silently drops
# the graph-inference-result packets delivered to the other one — and so does a
# second pod (EIE-212-F001): one replica per deployment until the channel is
# shared. Asserted by tests/unit/test_worker_singleton_invariant.py and
# tests/unit/test_deployment_topology.py.
# No migrate-on-start in production (AGENTS.md forbids `alembic upgrade head`
# in production context): the schema is applied as an explicit, operator-run
# release step before rollout, e.g. `docker run --rm <image> alembic upgrade head`.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
