# Production image. The previous version installed poetry and copied a
# `poetry.lock` that does not exist in this repository (the project is
# PEP 621 / setuptools, see pyproject.toml), and had no `git` for the
# git+https constellation-node-sdk dependency, so the build could not succeed.
#
# Supply chain: the base image is pinned by digest (python:3.12-slim at the
# time of pinning); every dependency, the SDK included (as the GitHub source
# archive of its release commit), is installed from requirements.lock with
# `--require-hashes`. Regenerate the lock with `bash tools/lock_requirements.sh`.
# The app runs from /app on PYTHONPATH; nothing is pip-installed from the tree.
FROM python@sha256:8edbf9e42c7fb168b9c523718ed907117e6d2e60f5889c0c499bbda3a787da53 AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY requirements.lock ./
RUN python -m pip install --require-hashes --no-deps -r requirements.lock

FROM deps AS prod
COPY . .
RUN adduser --disabled-password --gecos "" appuser \
    && chown -R appuser /app
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1
# EIE-003: ONE worker per container — see the note in ./Dockerfile. The
# GraphReturnChannel singleton is per-process, so a second worker silently drops
# the graph-inference-result packets delivered to the other one — and so does a
# second pod (EIE-212-F001): one replica per deployment until the channel is
# shared. Asserted by tests/unit/test_worker_singleton_invariant.py and
# tests/unit/test_deployment_topology.py.
# Apply the schema (alembic upgrade head) before serving; see the script.
ENTRYPOINT ["sh", "/app/scripts/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
