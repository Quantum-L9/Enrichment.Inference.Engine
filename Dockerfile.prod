# Production image. The previous version installed poetry and copied a
# `poetry.lock` that does not exist in this repository (the project is
# PEP 621 / setuptools, see pyproject.toml), and had no `git` for the
# git+https constellation-node-sdk dependency, so the build could not succeed.
#
# Dependencies are installed from requirements.lock, which pins every resolved
# version (regenerate with
# `uv pip compile pyproject.toml --python-version 3.12 -o requirements.lock`).
# The base is the interpreter the lock was resolved for and CI runs on.
FROM python:3.12-slim AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY requirements.lock ./
RUN python -m pip install --no-deps -r requirements.lock

FROM deps AS prod
COPY . .
RUN python -m pip install --no-deps . \
    && adduser --disabled-password --gecos "" appuser \
    && chown -R appuser /app
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
