    },
    {
      "id": "sdk_failure_packet_reason",
      "payload": {"status": "failed", "error": "RuntimeError", "message": "provider unavailable", "packet_id": "p-1"},
      "expect": {"status": "RuntimeError: provider unavailable", "failure_reason": "RuntimeError: provider unavailable", "state": null, "final_fields": {}}
