# =============================================================================
# L9 Service — Environment Template
# cp .env.template .env.local → fill in values
# =============================================================================

# --- REQUIRED ---
APP_NAME=l9-service
APP_API_KEY=
APP_PORT=8000

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# --- Dev ---
DEBUG=false
LOG_LEVEL=INFO
APP_MODULE=engine.main:app

# --- Gate (the only peer; ENV-SIG-01 parity 2026-10-22) ---
# Gate's shipped port is 9000. Signing names are the SDK's L9_* contract; the
# key id this node signs with and the Gate key id it verifies are fixed across
# the dev examples. Key material is never committed (C-10): fill L9_SIGNING_KEY
# and L9_VERIFYING_KEYS_JSON ({"gate-v1": "<Gate's key>"}) from your secret
# store, then set L9_REQUIRE_SIGNATURE=true.
GATE_URL=http://gate:9000
L9_REQUIRE_SIGNATURE=false
L9_SIGNING_ALGORITHM=hmac-sha256
L9_SIGNING_KEY=
L9_SIGNING_KEY_ID=enrichment-engine-v1
L9_VERIFYING_KEYS_JSON=
